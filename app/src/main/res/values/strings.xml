<resources>
    <string name="app_name" translatable="false">AnimNav</string>
    <string name="service_name" translatable="false">AnimNav</string>
    <string name="service_description">Draws the images you choose over the buttons of the 3-button navigation bar. Taps pass straight through to the real buttons. To know when the bar is showing, it only looks at the type, position and title of windows; it never reads what is inside them.</string>

    <!-- Status -->
    <string name="status_on">Overlay is on</string>
    <string name="status_off">Overlay is off</string>

    <!-- Setup -->
    <string name="section_setup">Setup</string>
    <string name="setup_steps">1. Open App info → ⋮ (top right) → Allow restricted settings. This is only needed when the app was installed from a file.\n2. Open Accessibility settings → Installed apps → AnimNav → turn it on.\n3. In your navigation bar app (for example Good Lock NavStar), set the button icons to transparent images.</string>
