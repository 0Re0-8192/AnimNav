<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="service_description">ナビゲーションバー(3ボタン)のボタンの上に、取り込んだ画像を動かして重ねて表示します。タップはすべて下の本物のボタンに素通りします。ナビゲーションバーが出ているかを知るために、ウィンドウの種類・位置・タイトルだけを見ます。ウィンドウの中身(文字など)は読み取りません。</string>

    <string name="status_on">重ね描き:オン</string>
    <string name="status_off">重ね描き:オフ</string>
    <string name="status_on_hint">ナビゲーションバーの上に描いています。</string>
    <string name="status_off_hint">「準備」の手順でオンにしてください。</string>

    <string name="section_setup">準備</string>
    <string name="setup_steps">1. 「アプリ情報」→ 右上の︙ →「制限付き設定を許可」(ファイルから入れたときだけ必要です)\n2. 「アクセシビリティ設定」→ インストール済みアプリ →「AnimNav」をオン\n3. ナビバーを着せ替えるアプリ(Good Lock の NavStar など)で、ボタンのアイコンを透明な画像にしてください(本物のアイコンが透けないように)</string>
    <string name="btn_app_info">アプリ情報を開く</string>
    <string name="btn_accessibility">アクセシビリティ設定を開く</string>

    <string name="section_images">画像</string>
    <string name="images_help">ボタンごとに画像を選びます。GIF・WebP(アニメも可)、PNG 1枚、PNG 連番を固めた ZIP に対応。「キーボードを閉じる」を設定しないと、キーボード表示中も「戻る」の絵のままです。</string>
    <string name="slot_back">戻る</string>
    <string name="slot_home">ホーム</string>
    <string name="slot_recents">履歴</string>
    <string name="slot_hidekb">キーボードを閉じる</string>
    <string name="slot_not_set">未設定</string>
    <string name="slot_not_set_hidekb">未設定(戻るの絵を使います)</string>
